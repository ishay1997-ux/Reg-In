{
  "name": "reg-in",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test --config=playwright.e2e.config.js --grep-invert בדיקת-עשן",
    "smoke": "node scripts/smoke.mjs",
    "dup": "jscpd src",
    "deadcode": "knip",
    "audit": "node scripts/audit-gate.mjs",
    "check:context": "node scripts/check-context.mjs",
    "check:docs-structure": "node scripts/check-docs-structure.mjs",
    "check:bidi": "node scripts/check-bidi-glyphs.mjs",
    "verify": "npm run lint && npm run format:check && npm run test:run && npm run build",
    "gate": "npm run verify && npm run dup && npm run deadcode && npm run audit && npm run check:bidi && npm run check:context && npm run check:docs-structure",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.9"
  }
}
