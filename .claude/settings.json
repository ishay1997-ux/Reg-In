{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "statusMessage": "טוען הקשר-פתיחה...",
            "command": "bash .claude/hooks/session-start-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|mcp__Desktop_Commander__write_file|mcp__Desktop_Commander__edit_block|mcp__Desktop_Commander__move_file|mcp__Desktop_Commander__create_directory|mcp__Desktop_Commander__start_process",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "statusMessage": "בודק הגנה על קבצי האפיון הקפואים...",
            "command": "bash .claude/hooks/protect-frozen-files.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "statusMessage": "בודק אם התיעוד מעודכן...",
            "command": "bash .claude/hooks/check-docs-updated.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "project-artifact@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "code-modernization@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false
  }
}