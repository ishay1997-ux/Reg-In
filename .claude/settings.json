{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "statusMessage": "טוען הקשר-פתיחה...",
            "command": "bash .claude/hooks/session-start-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|mcp__Desktop_Commander__write_file|mcp__Desktop_Commander__edit_block|mcp__Desktop_Commander__move_file|mcp__Desktop_Commander__create_directory|mcp__Desktop_Commander__start_process",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "statusMessage": "בודק הגנה על קבצי האפיון הקפואים...",
            "command": "bash .claude/hooks/protect-frozen-files.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "statusMessage": "בודק אם docs/CLAUDE_CODE_LOG.md ו-STATUS.md מעודכנים...",
            "command": "bash .claude/hooks/check-docs-updated.sh"
          }
        ]
      }
    ]
  }
}