# משתני הסביבה של Reg-In (Vite חושף רק משתנים עם קידומת VITE_).
# העתק קובץ זה ל-.env.local (שמוחרג ב-.gitignore) ומלא ערכים אמיתיים.
# ב-Vercel: הזן את שני המשתנים ב-Project Settings > Environment Variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# אופציונלי — רק להרצת e2e מקומית (npm run test:e2e / Playwright, נקרא ב-e2e/*.spec.js).
# בלי המשתנים האלה הבדיקות מדלגות על עצמן אוטומטית (לא נכשלות) — לא חובה למלא כדי לעבוד על הפרויקט.
# עמית: אם תרצה להריץ e2e מקומית, בקש את הפרטים מישי בערוץ פרטי (לא ב-git, לא בצ'אט).
E2E_CEO_EMAIL=
E2E_CEO_PASSWORD=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
