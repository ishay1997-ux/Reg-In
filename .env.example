# משתני הסביבה של Reg-In (Vite חושף רק משתנים עם קידומת VITE_).
# העתק קובץ זה ל-.env.local (שמוחרג ב-.gitignore) ומלא ערכים אמיתיים.
# ב-Vercel: הזן את שני המשתנים ב-Project Settings > Environment Variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# פרטי משתמשי-בדיקה לריצת e2e (Playwright בלבד, נקרא ב-e2e/*.spec.js). לא ערכים אמיתיים כאן.
E2E_CEO_EMAIL=
E2E_CEO_PASSWORD=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
